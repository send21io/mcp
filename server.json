{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.send21io/mcp",
  "title": "send21",
  "description": "Crypto pay links and API for people and AI agents. BTC, Lightning, USDC, USDT, EURC, SOL, ETH.",
  "websiteUrl": "https://send21.io/docs/mcp",
  "version": "1.4.1",
  "icons": [
    {
      "src": "https://send21.io/branding/send21-icon-new.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://send21.io/apple-touch-icon-new.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://send21.io/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer s21_<api key>, created by the account owner at https://send21.io/api-keys",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
